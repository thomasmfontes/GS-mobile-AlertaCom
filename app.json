{
  "expo": {
    "name": "AlertaCom",
    "slug": "alertacom",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "alertacom",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.thomasfontes.alertacom",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0F2942"
      },
      "softwareKeyboardLayoutMode": "resize",
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "O AlertaCom precisa de acesso à galeria para você selecionar a foto do incidente urbano.",
          "cameraPermission": "O AlertaCom precisa de acesso à câmera para você registrar o alagamento ou bueiro obstruído."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "2a8c90b3-2a58-4d17-b55c-0f7798baf262"
      }
    },
    "owner": "thomasfontes"
  }
}
